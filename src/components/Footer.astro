---
import { navMenus } from "../data/courses";
---

<section class="footer-lead relative grid min-h-svh place-items-center overflow-hidden bg-footer-lead" data-footer-lead>
	<div
		class="footer-lead__bg absolute z-0 bg-cover bg-center bg-no-repeat"
		style="background-image: url('/common/img/common/bg_footer03.jpg')"
		aria-hidden="true"
	>
	</div>
	<div
		class="footer-lead__content relative z-[1] flex flex-col items-center gap-xl px-[var(--container-padding)] py-2xl text-center"
	>
		<p class="footer-lead__catch m-0 font-bold leading-[1.15] tracking-[-0.05em] text-white">
			Creating<br />
			Your<br />
			Future<br />
			With Us
		</p>
		<a
			class="footer-lead__cta inline-flex min-w-64 items-center justify-between gap-10 rounded-full border-0 bg-[#1a1a1c] py-[0.55rem] pr-[0.55rem] pl-7 text-[clamp(0.9375rem,1.6vw,1.0625rem)] font-bold tracking-[0.06em] text-white no-underline"
			href="https://rhythmfactory.jp/"
			target="_blank"
			rel="noopener noreferrer"
		>
			<span class="footer-lead__cta-label leading-tight">制作のご相談</span>
			<span
				class="footer-lead__cta-icon grid size-11 shrink-0 place-items-center rounded-full bg-white text-[#1a1a1c]"
				aria-hidden="true"
			>
				<span class="footer-lead__cta-arrow inline-block text-lg leading-none">→</span>
			</span>
		</a>
	</div>
</section>

<footer class="site-footer flex min-h-svh flex-col overflow-hidden bg-[#e8e8e8] text-text">
	<div class="site-footer__primary flex flex-1 items-center border-b border-black/10 bg-footer-primary text-white">
		<div
			class="site-footer__primary-inner container flex items-start justify-between gap-xl py-2xl max-[767px]:flex-col max-[767px]:gap-lg max-[767px]:py-xl"
		>
			<a href="/" class="site-logo site-footer__brand mr-0">smart</a>
			<nav class="site-footer__sitemap" aria-label="サイトマップ">
				<ul class="m-0 flex list-none flex-col items-end gap-sm p-0 max-[767px]:items-start">
					{
						navMenus.map((menu) => (
							<li>
								<a
									href={menu.href}
									class="text-[clamp(1rem,2vw,1.25rem)] font-bold tracking-[0.04em] text-white hover:underline"
								>
									{menu.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
	</div>

	<div class="site-footer__secondary shrink-0 overflow-hidden">
		<div class="site-footer__secondary-inner container flex flex-col items-stretch gap-sm pt-md pb-0">
			<p class="site-footer__copyright m-0 text-xs tracking-[0.04em] text-muted">
				&copy; rhythmfactory Ltd. All Rights Reserved.
			</p>
			<a
				class="site-footer__rhythm block w-full overflow-hidden"
				href="https://rhythmfactory.jp/"
				target="_blank"
				rel="noopener noreferrer"
			>
				<img
					class="site-footer__rhythm-img block h-auto w-full"
					src="/common/img/common/logo_rhythmfactory.svg"
					alt="rhythmfactory"
					width="501"
					height="81"
				/>
			</a>
		</div>
	</div>
</footer>

<script>
	/** @type {null | (() => void)} */
	let disposeFooterLead = null;

	function initFooterLead() {
		disposeFooterLead?.();
		disposeFooterLead = null;

		const section = document.querySelector("[data-footer-lead]");
		if (!(section instanceof HTMLElement)) return;

		const bg = section.querySelector(".footer-lead__bg");
		const catchEl = section.querySelector(".footer-lead__catch");
		if (!(bg instanceof HTMLElement) || !(catchEl instanceof HTMLElement)) return;

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		if (prefersReducedMotion) {
			section.classList.add("is-inview");
			return;
		}

		const LERP = 0.07;
		const BG_RANGE = 56;
		const TEXT_RANGE = 28;
		let bgY = 0;
		let textY = 0;
		let ticking = false;
		let frameId = 0;

		const progressOf = () => {
			const rect = section.getBoundingClientRect();
			const span = window.innerHeight + rect.height;
			if (span <= 0) return 0.5;
			return (window.innerHeight - rect.top) / span;
		};

		const targetOffset = (progress, range) => {
			const eased = progress * progress * (3 - 2 * progress);
			return (0.5 - eased) * range * 2;
		};

		const update = () => {
			ticking = false;
			const progress = progressOf();
			const nextBg = targetOffset(progress, BG_RANGE);
			const nextText = targetOffset(progress, TEXT_RANGE);

			bgY += (nextBg - bgY) * LERP;
			textY += (nextText - textY) * LERP;

			bg.style.setProperty("--parallax-y", `${bgY.toFixed(2)}px`);
			catchEl.style.setProperty("--parallax-y", `${textY.toFixed(2)}px`);

			if (Math.abs(nextBg - bgY) > 0.05 || Math.abs(nextText - textY) > 0.05) {
				ticking = true;
				frameId = requestAnimationFrame(update);
			}
		};

		const requestUpdate = () => {
			if (ticking) return;
			ticking = true;
			frameId = requestAnimationFrame(update);
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					section.classList.add("is-inview");
					observer.unobserve(section);
				}
			},
			{ threshold: 0.28, rootMargin: "0px 0px -6% 0px" },
		);

		observer.observe(section);
		window.addEventListener("scroll", requestUpdate, { passive: true });
		window.addEventListener("resize", requestUpdate);
		requestUpdate();

		disposeFooterLead = () => {
			observer.disconnect();
			window.removeEventListener("scroll", requestUpdate);
			window.removeEventListener("resize", requestUpdate);
			cancelAnimationFrame(frameId);
			ticking = false;
		};
	}

	document.addEventListener("astro:page-load", initFooterLead);
</script>
