---
import House from "@lucide/astro/icons/house";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import { getBreadcrumbItems } from "../lib/breadcrumbs";

interface Props {
	placement?: "top" | "bottom";
}

const { placement = "top" } = Astro.props;
const isBottom = placement === "bottom";
const items = await getBreadcrumbItems(Astro.url.pathname);
const origin = Astro.url.origin;
const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: items.map((item, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: item.label,
		item: new URL(item.href, origin).href,
	})),
});
---

{
	items.length > 0 ? (
		<nav
			class:list={["site-breadcrumb", isBottom && "site-breadcrumb--bottom"]}
			aria-label={isBottom ? "パンくずリスト（ページ下部）" : "パンくずリスト"}
		>
			<div class="container">
				<ol class="site-breadcrumb__list m-0 flex list-none flex-wrap items-center p-0 text-sm text-muted">
					{items.map((item, index) => (
						<li class="site-breadcrumb__item flex items-center">
							{index > 0 ? <ChevronRight class="site-breadcrumb__sep" size={16} /> : null}
							{item.current ? (
								<span class="site-breadcrumb__current" aria-current={isBottom ? undefined : "page"}>
									{item.label}
								</span>
							) : index === 0 ? (
								<a class="site-breadcrumb__link inline-flex items-center hover:text-text" href={item.href} aria-label={item.label}>
									<House class="site-breadcrumb__home" size={18} />
								</a>
							) : (
								<a class="site-breadcrumb__link hover:text-text hover:underline" href={item.href}>
									{item.label}
								</a>
							)}
						</li>
					))}
				</ol>
			</div>
			{isBottom ? null : <script type="application/ld+json" set:html={jsonLd} />}
		</nav>
	) : null
}
