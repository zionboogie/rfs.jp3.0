---
import { aboutSlides, parseTitleTokens, plainTitle } from "../data/aboutSlides";

const slides = aboutSlides;
---

<section
	class="about-intro relative h-svh min-h-svh w-full overflow-hidden bg-[#1a1a1a]"
	data-about-intro
>
	<div class="about-intro__stage absolute inset-0">
		{
			slides.map((slide, index) => {
				const { tokens: titleTokens, charCount } = slide.title
					? parseTitleTokens(slide.title)
					: { tokens: [], charCount: 0 };
				const catchDelaySec =
					charCount === 0 ? 0 : (charCount - 1) * 0.1 + 0.85 + 0.5;
				return (
					<div
						class:list={["about-intro__slide absolute inset-0", { "is-active": index === 0 }]}
						data-slide={index}
					>
						<div
							class:list={[
								"about-intro__photo absolute",
								{ [`about-intro__photo--tone-${index}`]: !slide.image },
							]}
							style={slide.image ? `background-image: url(${slide.image})` : undefined}
							aria-hidden="true"
						/>
						<div class="about-intro__panel absolute inset-y-0 right-0 z-[2] bg-[#ececec]">
							<div
								class="about-intro__text relative z-[1] flex h-full items-center px-xl pb-xl pt-[calc(var(--header-height)+var(--spacing-lg))]"
							>
								{(slide.icon || slide.title || slide.catchCopy.length > 0) && (
									<div
										class="about-intro__copy flex max-w-[28rem] flex-col gap-md text-[#222]"
										style={`--title-length: ${charCount}; --catch-delay: ${catchDelaySec}s`}
									>
										{slide.icon && (
											<img
												class="about-intro__icon object-contain"
												src={slide.icon}
												alt=""
												width="140"
												height="140"
											/>
										)}
										{slide.title && (
											<h2
												class="about-intro__title m-0 text-[clamp(2rem,4.2vw,3.25rem)] font-bold leading-[1.45] tracking-[0.06em] text-white"
												aria-label={plainTitle(slide.title)}
											>
												{titleTokens.map((token) =>
													token.type === "br" ? (
														<br />
													) : (
														<span
															class="about-intro__char inline-block"
															style={`--char-index: ${token.index}`}
														>
															{token.value === " " ? "\u00A0" : token.value}
														</span>
													),
												)}
											</h2>
										)}
										{slide.catchCopy.length > 0 && (
											<p class="about-intro__catch m-0 text-[clamp(1.125rem,2.2vw,1.5rem)] font-medium leading-normal tracking-[0.04em]">
												{slide.catchCopy.map((line, lineIndex) => (
													<>
														{lineIndex > 0 && <br />}
														<span
															class="about-intro__catch-line inline-block bg-white px-[0.35em] py-[0.02em] text-[#555]"
															style={`--line-index: ${lineIndex}`}
														>
															{line}
														</span>
													</>
												))}
											</p>
										)}
									</div>
								)}
							</div>
						</div>
					</div>
				);
			})
		}
	</div>

	<aside
		class="about-intro__nav absolute top-1/2 right-md z-[3] flex -translate-y-1/2 flex-col items-center gap-md text-[#222]"
		aria-hidden="true"
	>
		<span class="about-intro__explore text-[0.8125rem] font-bold tracking-[0.14em] [writing-mode:vertical-rl]">
			Explore!
		</span>
		<ol class="about-intro__steps m-0 flex list-none flex-col items-center gap-sm p-0 text-[0.8125rem] font-bold tracking-[0.08em]">
			{
				slides.map((slide, index) => (
					<li class:list={["relative", { "is-active": index === 0 }]} data-step={index}>
						{slide.number}
					</li>
				))
			}
		</ol>
	</aside>
</section>

<script>
	const PANEL_HOLD_MS = 1000;
	const FADE_MS = 1600;
	const CHAR_STEP_MS = 100;
	const CHAR_FADE_MS = 850;
	const CATCH_AFTER_TITLE_MS = 500;
	const CATCH_LINE_EXPAND_MS = 1000;
	const CATCH_LINE_STEP_MS = 400;
	const TEXT_HOLD_MS = 2000;
	const TEXT_OUT_MS = 900;

	function initAboutIntroAnimation() {
		const section = document.querySelector("[data-about-intro]");
		const header = document.querySelector(".site-header");
		if (!(section instanceof HTMLElement)) return;
		if (section.dataset.animated === "true") return;

		const slides = [...section.querySelectorAll<HTMLElement>(".about-intro__slide")];
		const steps = section.querySelectorAll<HTMLElement>(".about-intro__steps [data-step]");
		let currentIndex = 0;
		let isBusy = false;

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const setStep = (index: number) => {
			for (const step of steps) {
				step.classList.toggle("is-active", Number(step.dataset.step) === index);
			}
		};

		const getCatchDoneMs = (slide: HTMLElement) => {
			const titleCharCount = slide.querySelectorAll(".about-intro__char").length;
			const lineCount = slide.querySelectorAll(".about-intro__catch-line").length;
			const titleDoneMs =
				titleCharCount === 0 ? 0 : (titleCharCount - 1) * CHAR_STEP_MS + CHAR_FADE_MS;
			if (lineCount === 0) return titleDoneMs;
			const catchStartMs = titleDoneMs + (titleCharCount > 0 ? CATCH_AFTER_TITLE_MS : 0);
			return catchStartMs + (lineCount - 1) * CATCH_LINE_STEP_MS + CATCH_LINE_EXPAND_MS;
		};

		const startExpand = (slide: HTMLElement) => {
			slide.classList.remove("is-expanding", "is-expanded");
			void slide.offsetWidth;
			slide.classList.add("is-expanding");
		};

		const playTextAndExpand = (slide: HTMLElement) => {
			slide.classList.remove("is-text-ready", "is-text-out", "is-expanding", "is-expanded");
			void slide.offsetWidth;
			slide.classList.add("is-text-ready");

			if (prefersReducedMotion) {
				slide.classList.add("is-expanded");
				window.setTimeout(goNext, 3000);
				return;
			}

			const catchDoneMs = getCatchDoneMs(slide);
			window.setTimeout(() => {
				if (!slide.classList.contains("is-active")) return;
				slide.classList.add("is-text-out");
				window.setTimeout(() => {
					if (!slide.classList.contains("is-active")) return;
					startExpand(slide);
				}, TEXT_OUT_MS);
			}, catchDoneMs + TEXT_HOLD_MS);
		};

		const goNext = () => {
			if (isBusy || slides.length <= 1) return;
			isBusy = true;

			const current = slides[currentIndex];
			const nextIndex = (currentIndex + 1) % slides.length;
			const next = slides[nextIndex];

			next.classList.remove(
				"is-expanding",
				"is-expanded",
				"is-leaving",
				"is-active",
				"is-text-ready",
				"is-text-out",
			);
			next.classList.add("is-under");

			current.classList.add("is-leaving");
			current.classList.remove("is-active");
			setStep(nextIndex);

			window.setTimeout(() => {
				current.classList.remove(
					"is-leaving",
					"is-expanding",
					"is-expanded",
					"is-text-ready",
					"is-text-out",
				);
				next.classList.remove("is-under");
				next.classList.add("is-active");
				currentIndex = nextIndex;
				isBusy = false;
				playTextAndExpand(next);
			}, FADE_MS);
		};

		const onPanelAnimationEnd = (event: AnimationEvent) => {
			if (event.animationName !== "about-panel-expand") return;
			const panel = event.currentTarget;
			if (!(panel instanceof HTMLElement)) return;
			const slide = panel.closest(".about-intro__slide");
			if (!(slide instanceof HTMLElement)) return;
			if (!slide.classList.contains("is-active")) return;

			slide.classList.remove("is-expanding");
			slide.classList.add("is-expanded");

			window.setTimeout(goNext, PANEL_HOLD_MS);
		};

		for (const slide of slides) {
			const panel = slide.querySelector(".about-intro__panel");
			if (panel instanceof HTMLElement) {
				panel.addEventListener("animationend", onPanelAnimationEnd);
			}
		}

		const show = () => {
			if (section.dataset.animated === "true") return;
			section.dataset.animated = "true";
			window.requestAnimationFrame(() => {
				section.classList.add("is-visible");
				const first = slides[0];
				if (!first) return;
				playTextAndExpand(first);
			});
		};

		if (header?.dataset.animated === "true") {
			show();
			return;
		}

		document.addEventListener("site-intro:complete", show, { once: true });
	}

	document.addEventListener("astro:page-load", initAboutIntroAnimation);
</script>
