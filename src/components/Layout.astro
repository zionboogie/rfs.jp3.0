---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	skipIntro?: boolean;
}

const { title, description, skipIntro = false } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title ?? "サイトタイトル"}</title>
		<meta name="description" content={description ?? "サイトの説明文です。"} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c&family=Marcellus&family=Zen+Kaku+Gothic+Antique&display=swap"
			rel="stylesheet"
		/>
		<ClientRouter />
	</head>
	<body class:list={{ "is-intro": !skipIntro }} transition:animate="fade">
		<Header skipIntro={skipIntro} />
		<slot />
		<Footer />
	</body>
</html>
