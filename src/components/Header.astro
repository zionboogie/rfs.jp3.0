---
import { navMenus } from "../data/courses";
import { aboutSlideAssetUrls } from "../data/aboutSlides";

interface Props {
	skipIntro?: boolean;
}

const { skipIntro = false } = Astro.props;
const primaryMenus = navMenus.filter((menu) => menu.id !== "archive");
const archiveMenu = navMenus.find((menu) => menu.id === "archive");
const searchQuery = Astro.url.searchParams.get("q") ?? "";
---

<header
	class:list={[
		"site-header fixed inset-x-0 top-0 z-[100] border-b border-transparent bg-transparent",
		skipIntro ? "is-ready is-logo-ready is-no-intro" : "is-intro",
	]}
	data-skip-intro={skipIntro ? "" : undefined}
	data-slide-assets={JSON.stringify(aboutSlideAssetUrls)}
>
	<div class="site-header__intro fixed inset-0 z-[200] grid place-items-center" aria-hidden="true" hidden={skipIntro}>
		<div class="site-header__intro-content flex flex-col items-center gap-xs text-center">
			<p class="site-logo site-logo--intro">smart</p>
			<p
				class="site-header__intro-tagline m-0 text-[clamp(1.25rem,3.5vw,2.25rem)] font-bold tracking-[0.12em] text-text"
			>
				AIと一緒に、コードを書こう。
			</p>
		</div>
	</div>
	<div class="site-header__chrome pointer-events-none absolute inset-0 z-[1]" aria-hidden="true"></div>
	<div class="site-header__inner container relative z-[2] flex items-center gap-md py-sm">
		<a href="/" class="site-logo">smart</a>
		<nav class="global-nav hidden md:block" aria-label="グローバルナビ">
			<ul class="flex list-none flex-wrap gap-y-sm gap-x-md p-0">
				{
					navMenus.map((menu) => (
						<li>
							<a href={menu.href} class="font-bold hover:text-text hover:no-underline">
								<span>{menu.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<form class="header-search ml-auto hidden shrink-0 gap-2 md:flex" action="/search/" method="get" role="search">
			<label class="visually-hidden" for="header-search-input">サイト内検索</label>
			<input
				id="header-search-input"
				class="rounded-sm border border-white/60 bg-white px-3 py-2"
				type="search"
				name="q"
				value={searchQuery}
				placeholder="キーワードで検索"
			/>
			<button
				type="submit"
				class="cursor-pointer rounded-sm border-0 bg-text px-4 py-2 font-bold text-white"
			>
				検索
			</button>
		</form>
		<button
			type="button"
			class="menu-toggle ml-auto flex size-11 shrink-0 cursor-pointer items-center justify-center border-0 bg-transparent p-0 md:hidden"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="メニューを開く"
		>
			<span class="menu-toggle__bars" aria-hidden="true">
				<span class="menu-toggle__bar"></span>
				<span class="menu-toggle__bar"></span>
				<span class="menu-toggle__bar"></span>
			</span>
		</button>
	</div>
	<nav class="mobile-nav" id="mobile-nav" aria-label="カテゴリ" inert>
		<ul class="mobile-nav__list">
			{
				primaryMenus.map((menu) => (
					<li>
						<a href={menu.href} class="text-h3 font-bold hover:text-text hover:no-underline">
							<span>{menu.label}</span>
						</a>
					</li>
				))
			}
			{
				archiveMenu ? (
					<li class="mobile-nav__archive">
						<a href={archiveMenu.href} class="text-h3 font-bold hover:text-text hover:no-underline">
							<span>{archiveMenu.label}</span>
						</a>
					</li>
				) : null
			}
		</ul>
	</nav>
</header>

<script>
	const COMPACT_DELAY_MS = 1100;
	const INTRO_FADE_MS = 950;
	const INTRO_SEEN_KEY = "rfs-intro-seen";

	function hasSeenIntro() {
		try {
			return sessionStorage.getItem(INTRO_SEEN_KEY) === "1";
		} catch {
			return false;
		}
	}

	function markIntroSeen() {
		try {
			sessionStorage.setItem(INTRO_SEEN_KEY, "1");
			document.documentElement.dataset.introSeen = "1";
		} catch {
			/* ignore */
		}
	}

	function applySkippedIntro(root) {
		const header = root.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;
		root.body?.classList.remove("is-intro", "is-intro-leaving");
		header.classList.add("is-ready", "is-logo-ready", "is-no-intro");
		header.classList.remove("is-intro");
		const intro = header.querySelector(".site-header__intro");
		if (intro instanceof HTMLElement) intro.hidden = true;
	}

	function preloadImages(urls) {
		return Promise.all(
			urls.map(
				(url) =>
					new Promise((resolve) => {
						const image = new Image();
						image.onload = () => resolve();
						image.onerror = () => resolve();
						image.src = url;
					}),
			),
		);
	}

	function getSlideAssetUrls(header) {
		try {
			const raw = header.dataset.slideAssets;
			const parsed = raw ? JSON.parse(raw) : [];
			return Array.isArray(parsed) ? parsed : [];
		} catch {
			return [];
		}
	}

	function initHeaderAnimation() {
		const header = document.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;
		if (header.hasAttribute("data-skip-intro") || header.dataset.animated === "true" || hasSeenIntro()) {
			applySkippedIntro(document);
			header.dataset.animated = "true";
			document.dispatchEvent(new CustomEvent("site-intro:complete"));
			return;
		}

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const slideAssetUrls = getSlideAssetUrls(header);

		const finishIntro = () => {
			markIntroSeen();
			document.body.classList.add("is-intro-leaving");
			document.body.classList.remove("is-intro");
			document.dispatchEvent(new CustomEvent("site-intro:complete"));

			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					header.classList.add("is-ready");
					header.classList.remove("is-intro");

					window.setTimeout(() => {
						header.dataset.animated = "true";
						const intro = header.querySelector(".site-header__intro");
						if (intro instanceof HTMLElement) intro.hidden = true;
						document.body.classList.remove("is-intro-leaving");
						// visibility が戻ってからロゴフェードを開始
						requestAnimationFrame(() => {
							header.classList.add("is-logo-ready");
						});
					}, INTRO_FADE_MS);
				});
			});
		};

		const waitMinimumIntro = () =>
			new Promise((resolve) => {
				window.setTimeout(resolve, prefersReducedMotion ? 0 : COMPACT_DELAY_MS);
			});

		const waitAssets = () => preloadImages(slideAssetUrls);

		if (prefersReducedMotion) {
			header.classList.add("is-logo-clear");
			Promise.all([waitAssets(), waitMinimumIntro()]).then(finishIntro);
			return;
		}

		document.body.classList.add("is-intro");

		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				header.classList.add("is-logo-clear");
			});
		});

		// ロゴ演出の最短時間 + スライド画像の先読み完了を待ってからイントロ終了
		Promise.all([waitAssets(), waitMinimumIntro()]).then(finishIntro);
	}

	function initHeaderScroll() {
		const header = document.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;
		if (header.dataset.scrollReady === "true") return;
		header.dataset.scrollReady = "true";

		const HIDE_THRESHOLD_PX = 20;

		const onScroll = () => {
			if (!header.classList.contains("is-ready")) return;
			if (header.classList.contains("is-menu-open")) {
				header.classList.remove("is-hidden");
				return;
			}

			if (window.scrollY <= 8) {
				header.classList.remove("is-hidden");
				return;
			}

			if (window.scrollY > HIDE_THRESHOLD_PX) {
				header.classList.add("is-hidden");
			}
		};

		window.addEventListener("scroll", onScroll, { passive: true });
	}

	document.addEventListener("astro:before-swap", (event) => {
		if (!hasSeenIntro()) return;
		const doc = event.newDocument;
		if (!(doc instanceof Document)) return;
		doc.documentElement.dataset.introSeen = "1";
		applySkippedIntro(doc);
	});

	/** @type {AbortController | null} */
	let mobileNavAbort = null;

	function initMobileNav() {
		const header = document.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;

		const toggle = header.querySelector(".menu-toggle");
		const panel = header.querySelector(".mobile-nav");
		if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;

		mobileNavAbort?.abort();
		mobileNavAbort = new AbortController();
		const { signal } = mobileNavAbort;
		const desktopQuery = window.matchMedia("(min-width: 768px)");

		const setOpen = (open) => {
			toggle.setAttribute("aria-expanded", open ? "true" : "false");
			toggle.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
			panel.classList.toggle("is-open", open);
			panel.inert = !open;
			header.classList.toggle("is-menu-open", open);
			document.body.classList.toggle("is-menu-open", open);
			if (open) header.classList.remove("is-hidden");
		};

		toggle.addEventListener(
			"click",
			() => {
				setOpen(toggle.getAttribute("aria-expanded") !== "true");
			},
			{ signal },
		);

		document.addEventListener(
			"keydown",
			(event) => {
				if (event.key !== "Escape") return;
				if (toggle.getAttribute("aria-expanded") !== "true") return;
				setOpen(false);
				toggle.focus();
			},
			{ signal },
		);

		desktopQuery.addEventListener(
			"change",
			(event) => {
				if (event.matches) setOpen(false);
			},
			{ signal },
		);
	}

	function syncSearchInputs() {
		const query = new URLSearchParams(window.location.search).get("q");
		if (query === null) return;
		for (const input of document.querySelectorAll(".header-search input[name='q']")) {
			if (input instanceof HTMLInputElement) input.value = query;
		}
	}

	document.addEventListener("astro:page-load", () => {
		initHeaderAnimation();
		initHeaderScroll();
		initMobileNav();
		syncSearchInputs();
	});
</script>
