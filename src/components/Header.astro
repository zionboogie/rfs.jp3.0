---
import { navMenus } from "../data/courses";
import { aboutSlideAssetUrls } from "../data/aboutSlides";
---

<header
	class="site-header is-intro fixed inset-x-0 top-0 z-[100] border-b border-transparent bg-transparent transition-transform duration-[220ms] ease-in"
	data-slide-assets={JSON.stringify(aboutSlideAssetUrls)}
>
	<div class="site-header__intro fixed inset-0 z-[200] grid place-items-center" aria-hidden="true">
		<div class="site-header__intro-content flex flex-col items-center gap-xs text-center">
			<p class="site-logo site-logo--intro">smart</p>
			<p
				class="site-header__intro-tagline m-0 text-[clamp(1.25rem,3.5vw,2.25rem)] font-bold tracking-[0.12em] text-text"
			>
				AIと一緒に、コードを書こう。
			</p>
		</div>
	</div>
	<div class="site-header__chrome pointer-events-none absolute inset-0 z-[1]" aria-hidden="true"></div>
	<div class="site-header__inner container relative z-[2] flex items-center gap-md py-sm">
		<a href="/" class="site-logo">smart</a>
		<nav class="global-nav" aria-label="グローバルナビ">
			<ul class="flex list-none flex-wrap gap-y-sm gap-x-md p-0">
				{
					navMenus.map((menu) => (
						<li>
							<a href={menu.href} class="font-bold hover:text-text hover:no-underline">
								<span>{menu.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<form class="header-search ml-auto flex shrink-0 gap-2" action="/search" method="get" role="search">
			<label class="visually-hidden" for="header-search-input">サイト内検索</label>
			<input
				id="header-search-input"
				class="rounded-sm border border-white/60 bg-white px-3 py-2"
				type="search"
				name="q"
				placeholder="キーワードで検索"
			/>
			<button
				type="submit"
				class="cursor-pointer rounded-sm border-0 bg-text px-4 py-2 font-bold text-white"
			>
				検索
			</button>
		</form>
	</div>
</header>

<script>
	const COMPACT_DELAY_MS = 1100;
	const INTRO_FADE_MS = 950;

	function preloadImages(urls) {
		return Promise.all(
			urls.map(
				(url) =>
					new Promise((resolve) => {
						const image = new Image();
						image.onload = () => resolve();
						image.onerror = () => resolve();
						image.src = url;
					}),
			),
		);
	}

	function getSlideAssetUrls(header) {
		try {
			const raw = header.dataset.slideAssets;
			const parsed = raw ? JSON.parse(raw) : [];
			return Array.isArray(parsed) ? parsed : [];
		} catch {
			return [];
		}
	}

	function initHeaderAnimation() {
		const header = document.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;
		if (header.dataset.animated === "true") {
			document.body.classList.remove("is-intro");
			header.classList.add("is-ready", "is-logo-ready");
			header.classList.remove("is-intro");
			return;
		}

		const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const slideAssetUrls = getSlideAssetUrls(header);

		const finishIntro = () => {
			document.body.classList.add("is-intro-leaving");
			document.body.classList.remove("is-intro");
			document.dispatchEvent(new CustomEvent("site-intro:complete"));

			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					header.classList.add("is-ready");
					header.classList.remove("is-intro");

					window.setTimeout(() => {
						header.dataset.animated = "true";
						const intro = header.querySelector(".site-header__intro");
						if (intro instanceof HTMLElement) intro.hidden = true;
						document.body.classList.remove("is-intro-leaving");
						// visibility が戻ってからロゴフェードを開始
						requestAnimationFrame(() => {
							header.classList.add("is-logo-ready");
						});
					}, INTRO_FADE_MS);
				});
			});
		};

		const waitMinimumIntro = () =>
			new Promise((resolve) => {
				window.setTimeout(resolve, prefersReducedMotion ? 0 : COMPACT_DELAY_MS);
			});

		const waitAssets = () => preloadImages(slideAssetUrls);

		if (prefersReducedMotion) {
			header.classList.add("is-logo-clear");
			Promise.all([waitAssets(), waitMinimumIntro()]).then(finishIntro);
			return;
		}

		document.body.classList.add("is-intro");

		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				header.classList.add("is-logo-clear");
			});
		});

		// ロゴ演出の最短時間 + スライド画像の先読み完了を待ってからイントロ終了
		Promise.all([waitAssets(), waitMinimumIntro()]).then(finishIntro);
	}

	function initHeaderScroll() {
		const header = document.querySelector(".site-header");
		if (!(header instanceof HTMLElement)) return;
		if (header.dataset.scrollReady === "true") return;
		header.dataset.scrollReady = "true";

		const HIDE_THRESHOLD_PX = 20;

		const onScroll = () => {
			if (!header.classList.contains("is-ready")) return;

			if (window.scrollY <= 8) {
				header.classList.remove("is-hidden");
				return;
			}

			if (window.scrollY > HIDE_THRESHOLD_PX) {
				header.classList.add("is-hidden");
			}
		};

		window.addEventListener("scroll", onScroll, { passive: true });
	}

	document.addEventListener("astro:page-load", () => {
		initHeaderAnimation();
		initHeaderScroll();
	});
</script>
