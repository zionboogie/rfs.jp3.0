---
import { buildSeo, type SeoType } from "../lib/seo";

interface Props {
	title?: string;
	description?: string;
	type?: SeoType;
	noindex?: boolean;
	jsonLd?: string;
}

const meta = buildSeo({
	title: Astro.props.title,
	description: Astro.props.description,
	type: Astro.props.type,
	noindex: Astro.props.noindex,
	pathname: Astro.url.pathname,
	site: Astro.site,
	fallbackOrigin: Astro.url.origin,
});
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonical} />
<link rel="describedby" href={new URL("/llms.txt", meta.canonical).href} />
{meta.noindex ? <meta name="robots" content="noindex" /> : null}
<meta property="og:site_name" content={meta.siteName} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:type" content={meta.type} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:image" content={meta.imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.imageUrl} />
{Astro.props.jsonLd ? <script type="application/ld+json" set:html={Astro.props.jsonLd} /> : null}
