---
interface Props {
	index: number;
	title: string;
	description: string;
	href: string;
}

const { index, title, description, href } = Astro.props;
const indexLabel = String(index).padStart(2, "0");
---

<a href={href} class="course-list__item" style={`--item-index: ${index - 1}`}>
	<span class="course-list__index">({indexLabel})</span>
	<h3 class="course-list__title">{title}</h3>
	<p class="course-list__description">{description}</p>
</a>
