---
interface Props {
	index: number;
	title: string;
	description: string;
	href: string;
}

const { index, title, description, href } = Astro.props;
const indexLabel = String(index).padStart(2, "0");
---

<a
	href={href}
	class="course-list__item grid grid-cols-[2.75rem_minmax(0,1fr)] items-start gap-x-sm gap-y-sm border-b border-[rgb(33_5_5_/_18%)] py-[clamp(3.5rem,8vw,6rem)] text-inherit no-underline md:grid-cols-[3.25rem_minmax(10rem,0.95fr)_minmax(12rem,1.15fr)] md:gap-x-[clamp(1.5rem,7vw,5.5rem)] md:gap-y-0"
	style={`--item-index: ${index - 1}`}
>
	<span
		class="course-list__index pt-[0.45em] font-sans text-sm leading-snug tracking-[0.04em] text-[rgb(33_5_5_/_45%)]"
	>
		({indexLabel})
	</span>
	<h3
		class="course-list__title relative m-0 font-sans text-[clamp(1.75rem,3.6vw,2.75rem)] font-bold leading-[1.35] tracking-[0.02em]"
	>
		{title}
	</h3>
	<p
		class="course-list__description col-start-2 m-0 pt-[0.35em] text-[clamp(0.9375rem,1.5vw,1.0625rem)] leading-[1.9] text-[rgb(33_5_5_/_72%)] md:col-start-auto"
	>
		{description}
	</p>
</a>
