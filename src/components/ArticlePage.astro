---
import Copy from "@lucide/astro/icons/copy";
import ChevronLeft from "@lucide/astro/icons/chevron-left";
import ChevronRight from "@lucide/astro/icons/chevron-right";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArticleSidebar from "./ArticleSidebar.astro";
import type { CategorySummary } from "../lib/wordpress";
import "../styles/category.css";
import "../styles/article.css";

interface Props {
	learnCategories: CategorySummary[];
}

const { learnCategories } = Astro.props;

const publishedAt = "2026-08-26";
const updatedAt = "2026-08-26";
const articleTitle = "変数の宣言と使い方";
const articleTitleChars = [...articleTitle];

const relatedArticles = [
	{
		category: "JavaScript",
		title: "データ型の考え方",
		href: "#",
	},
	{
		category: "JavaScript",
		title: "関数を使って処理をまとめる",
		href: "#",
	},
	{
		category: "JavaScript",
		title: "配列で複数の値を扱う",
		href: "#",
	},
];
---

<main>
	<div class="container grid items-start gap-xl pb-xl lg:grid-cols-[minmax(0,1fr)_16rem]">
		<div class="article-layout__main min-w-0">
			<article>
				<header class="article-hero">
					<p class="article-hero__lesson mx-auto mt-[calc(var(--spacing-lg)*2)] mb-lg flex w-fit flex-col items-center">
						<span class="text-sm tracking-[0.12em]">LESSON</span>
						<span class="mt-xs flex flex-col items-center">
							<span class="article-hero__lesson-mask overflow-hidden">
								<span class="article-hero__lesson-digit block font-logo text-[length:calc(var(--text-h1)*2)] font-bold leading-none">01</span>
							</span>
							<span class="h-1 w-full bg-text" aria-hidden="true"></span>
						</span>
					</p>
					<div class="article-hero__title-wrap" style={`--article-title-chars: ${articleTitleChars.length}`}>
						<img
							class="article-hero__mugcup"
							src="/common/img/common/mugcup.jpg"
							alt=""
							width="100"
							height="218"
						/>
						<h1
							class="article-hero__title mb-[calc(var(--spacing-xl)*2)] text-center font-bold tracking-[0.04em] text-h1 leading-heading"
							aria-label={articleTitle}
						>
							{
								articleTitleChars.map((char, index) => (
									<span class="article-hero__title-char inline-block" style={`--char-index: ${index}`} aria-hidden="true">
										{char}
									</span>
								))
							}
						</h1>
					</div>
					<ul class="article-hero__tags mb-md flex list-none flex-wrap gap-xs p-0">
						<li>
							<a class="inline-block rounded-sm border border-border px-2 py-0.5 text-sm text-muted" href="#">基礎</a>
						</li>
						<li>
							<a class="inline-block rounded-sm border border-border px-2 py-0.5 text-sm text-muted" href="#">変数</a>
						</li>
					</ul>
					<p class="article-hero__lead m-0 max-w-[40rem] text-muted leading-body">
						プログラムの中で値を覚えておく箱、それが変数です。まずは宣言のしかたと、名前の付け方から見ていきます。
					</p>

					<div class="article-meta mt-lg flex flex-wrap items-start justify-between gap-sm border-t border-[rgb(33_5_5_/_18%)] pt-md">
						<div class="flex min-w-0 flex-wrap items-start gap-x-lg gap-y-sm">
							<div class="flex flex-col gap-sm">
								<p class="m-0 whitespace-nowrap leading-none">
									<span class="mr-sm align-top text-sm leading-none tracking-[0.04em] text-muted">公開日</span>
									<time class="align-top text-sm leading-none text-muted" datetime={publishedAt}>2026年8月26日</time>
								</p>
								<p class="m-0 whitespace-nowrap leading-none">
									<span class="mr-sm align-top text-sm leading-none tracking-[0.04em] text-muted">更新日</span>
									<time class="align-top text-sm leading-none text-muted" datetime={updatedAt}>2026年8月26日</time>
								</p>
							</div>
							<div class="flex flex-wrap items-start gap-x-md gap-y-sm">
								<p class="m-0 whitespace-nowrap leading-none">
									<span class="mr-sm align-top text-sm leading-none tracking-[0.04em] text-muted">読了時間</span>
									<span class="align-top text-sm leading-none">目安30分</span>
								</p>
								<div class="article-author flex items-center gap-sm">
									<img
										class="size-12 shrink-0 rounded-full object-cover"
										src="/common/img/common/profile_aoipasta.jpg"
										alt=""
										width="48"
										height="48"
									/>
									<div>
										<p class="m-0 font-bold leading-none">あおいパスタ</p>
										<p class="m-0">
											<a class="text-sm text-muted underline decoration-transparent underline-offset-4 hover:text-logo hover:decoration-current" href="#">
												プロフィール
											</a>
										</p>
									</div>
								</div>
							</div>
						</div>
						<nav class="article-share ml-auto shrink-0" aria-label="SNSでシェア">
							<ul class="m-0 flex list-none items-center justify-end gap-sm p-0">
								<li>
									<a class="article-share__link" href="#" aria-label="Facebookでシェア">
										<img src="/common/img/common/facebook-app-round-icon.svg" alt="" width="24" height="24" />
									</a>
								</li>
								<li>
									<a class="article-share__link" href="#" aria-label="Xでシェア">
										<img src="/common/img/common/x-social-media-black-icon.svg" alt="" width="24" height="24" />
									</a>
								</li>
								<li>
									<a class="article-share__link" href="#" aria-label="はてなブックマークでシェア">
										<span class="article-share__hatena" aria-hidden="true">B</span>
									</a>
								</li>
							</ul>
						</nav>
					</div>
				</header>

				<nav class="article-toc mb-xl" aria-labelledby="article-toc-heading">
					<h2 class="article-toc__heading" id="article-toc-heading">目次</h2>
					<ol class="article-toc__list m-0 flex list-decimal flex-col gap-xs pl-[1.5em]">
						<li>
							<a href="#intro">導入</a>
						</li>
						<li>
							<a href="#what">変数とは</a>
						</li>
						<li>
							<a href="#why">なぜ必要なのか</a>
						</li>
						<li>
							<a href="#try">実際に書いてみる</a>
						</li>
						<li>
							<a href="#browser">ブラウザで確認する</a>
						</li>
						<li>
							<a href="#summary">まとめ</a>
						</li>
					</ol>
				</nav>

				<div class="article-body">
					<h2 id="intro">導入</h2>
					<p>コードを書いていると、「今の値を、あとでも使いたい」という場面が出てきます。そのときに使うのが変数です。</p>
					<p>名前を付けて値を置いておく、それだけの仕組みですが、プログラムの土台になります。</p>

					<h2 id="what">変数とは</h2>
					<p>変数は、値を入れておく箱です。箱には名前が付いていて、あとからその名前で中身を取り出せます。</p>
					<p>
						JavaScriptでは、<code>const</code> や <code>let</code> を使って変数を宣言します。
					</p>

					<h2 id="why">なぜ必要なのか</h2>
					<p>同じ値を何度も書き直すと、変更が入ったときに漏れが起きます。変数にまとめておけば、直す場所は一箇所で済みます。</p>
					<ul>
						<li>値に名前を付けて、意図を伝えやすくする</li>
						<li>同じ値の使い回しを、安全にする</li>
						<li>あとから読み返したときに、何をしているか追いやすくする</li>
					</ul>

					<h2 id="try">実際に書いてみる</h2>
					<p>まずは <code>const</code> で、変更しない値を宣言してみます。</p>
					<pre><code>const title = "変数の基本";
console.log(title);</code></pre>
					<p>
						あとから値を変えたいときは <code>let</code> を使います。最初は <code>const</code> から始めると、意図がはっきりします。
					</p>

					<h2 id="browser">ブラウザで確認する</h2>
					<p>ブラウザの開発者ツールを開き、コンソールに先ほどのコードを貼り付けて実行してみてください。表示された文字列が、変数の中身です。</p>

					<h2 id="summary">まとめ</h2>
					<p>
						変数は、値に名前を付けて覚えておく仕組みです。まずは <code>const</code> で宣言し、必要になったら <code>let</code> を検討するところから始めましょう。
					</p>
				</div>

				<section class="article-ask mt-xl mb-xl" aria-labelledby="article-ask-heading">
					<h2 class="article-ask__heading mb-sm mt-0 text-h3 font-bold tracking-[0.02em]" id="article-ask-heading">AIに質問する</h2>
					<p class="article-ask__lead mb-md mt-0 text-muted">分からないところは、次の質問をコピーして AI に聞いてみてください。</p>
					<p class="mb-md">
						<button class="article-ask__button cursor-pointer rounded-sm border-0 bg-text px-4 py-2 font-bold text-white" type="button"> AIに質問する </button>
					</p>
					<div class="flex flex-col gap-sm">
						<div class="article-ask__item rounded-md border border-border bg-primary p-md">
							<p class="article-ask__text m-0">constとletの違いを、具体的なコード例を使って初心者にも分かるように説明してください。</p>
							<button
								class="article-ask__copy mt-sm inline-flex cursor-pointer items-center gap-xs rounded-sm border border-current bg-transparent px-3 py-1 text-sm font-bold"
								type="button"
							>
								<Copy size={16} />
								コピー
							</button>
						</div>
						<div class="article-ask__item rounded-md border border-border bg-primary p-md">
							<p class="article-ask__text m-0">constを使うメリットを、初心者向けに具体例を使って説明してください。</p>
							<button
								class="article-ask__copy mt-sm inline-flex cursor-pointer items-center gap-xs rounded-sm border border-current bg-transparent px-3 py-1 text-sm font-bold"
								type="button"
							>
								<Copy size={16} />
								コピー
							</button>
						</div>
					</div>
				</section>
			</article>

			<nav class="article-share mb-xl" aria-label="SNSでシェア（記事下部）">
				<ul class="m-0 flex list-none items-center gap-sm p-0">
					<li>
						<a class="article-share__link" href="#" aria-label="Facebookでシェア">
							<img src="/common/img/common/facebook-app-round-icon.svg" alt="" width="24" height="24" />
						</a>
					</li>
					<li>
						<a class="article-share__link" href="#" aria-label="Xでシェア">
							<img src="/common/img/common/x-social-media-black-icon.svg" alt="" width="24" height="24" />
						</a>
					</li>
					<li>
						<a class="article-share__link" href="#" aria-label="はてなブックマークでシェア">
							<span class="article-share__hatena" aria-hidden="true">B</span>
						</a>
					</li>
				</ul>
			</nav>

			<section class="article-continue overflow-hidden pb-xl" data-parallax="content" aria-labelledby="article-continue-heading">
				<div class="article-continue__layer">
					<h2 class="article-continue__heading mb-md mt-0 text-h3 font-bold tracking-[0.02em]" id="article-continue-heading">つづけて読む</h2>
					<p class="mb-md mt-0">続きの記事もあわせてどうぞ。</p>
					<p class="mb-md">
						<a class="article-continue__link flex items-center gap-sm rounded-md border border-border p-md" href="#">
							<ArrowRight class="shrink-0" size={20} aria-hidden="true" />
							<span class="underline underline-offset-[0.2em]"> WordPressのテーマを作る前に、絶対に知っておきたい4つの基礎知識 </span>
						</a>
					</p>
					<p class="m-0">エンジョイ！</p>
				</div>
			</section>

			<nav class="article-pager pb-xl" aria-label="前後の記事">
				<div class="grid gap-md md:grid-cols-2">
					<a class="article-pager__link flex items-center gap-sm no-underline" href="#" aria-label="前の記事：データ型とは">
						<span class="article-pager__arrow grid size-8 shrink-0 place-items-center rounded-md border border-border">
							<ChevronLeft size={20} />
						</span>
						<span class="font-bold tracking-[0.02em] text-h4 leading-heading">データ型とは</span>
					</a>
					<a class="article-pager__link flex items-center justify-start gap-sm text-left no-underline md:justify-end md:text-right" href="#" aria-label="次の記事：関数の基本">
						<span class="font-bold tracking-[0.02em] text-h4 leading-heading">関数の基本</span>
						<span class="article-pager__arrow grid size-8 shrink-0 place-items-center rounded-md border border-border">
							<ChevronRight size={20} />
						</span>
					</a>
				</div>
			</nav>

			<section class="article-related pt-xl pb-xl" aria-labelledby="article-related-heading">
				<h2 class="article-related__heading mb-lg mt-0 text-center text-h3 font-bold tracking-[0.02em]" id="article-related-heading">興味があるかも</h2>
				<ul class="m-0 grid list-none gap-md p-0 md:grid-cols-3">
					{
						relatedArticles.map((article) => (
							<li>
								<a class="article-related__card flex h-full flex-col gap-sm rounded-md border border-border p-md text-inherit no-underline" href={article.href}>
									<span class="text-sm tracking-[0.04em] text-muted">{article.category}</span>
									<span class="font-bold tracking-[0.02em] text-h4 leading-heading">{article.title}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>

		<ArticleSidebar categories={learnCategories} />
	</div>
</main>

<script>
	function syncArticleMugOrigin() {
		const wrap = document.querySelector(".article-hero__title-wrap");
		if (!(wrap instanceof HTMLElement)) return;
		wrap.style.setProperty("--mug-origin", `${-Math.round(wrap.getBoundingClientRect().left)}px`);
	}

	syncArticleMugOrigin();
	window.addEventListener("resize", syncArticleMugOrigin);
	document.addEventListener("astro:page-load", syncArticleMugOrigin);
</script>

<script>
	const LERP = 0.08;
	const CONTENT_RANGE = 28;

	/** @type {null | (() => void)} */
	let disposeContinueParallax = null;

	function initContinueParallax() {
		disposeContinueParallax?.();
		disposeContinueParallax = null;

		const section = document.querySelector(".article-continue[data-parallax]");
		const layer = section?.querySelector(".article-continue__layer");
		if (!(section instanceof HTMLElement) || !(layer instanceof HTMLElement)) return;

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			section.classList.add("is-inview");
			return;
		}

		section.classList.add("is-parallax-ready");

		let currentY = 0;
		let ticking = false;
		let frameId = 0;

		const progressOf = () => {
			const rect = section.getBoundingClientRect();
			const span = window.innerHeight + rect.height;
			if (span <= 0) return 0.5;
			return Math.min(1, Math.max(0, (window.innerHeight - rect.top) / span));
		};

		const targetOffset = (progress, range) => {
			const eased = progress * progress * (3 - 2 * progress);
			return (0.5 - eased) * range * 2;
		};

		const update = () => {
			ticking = false;
			const next = targetOffset(progressOf(), CONTENT_RANGE);
			currentY += (next - currentY) * LERP;
			layer.style.setProperty("--parallax-y", `${currentY.toFixed(2)}px`);

			if (Math.abs(next - currentY) > 0.05) {
				ticking = true;
				frameId = requestAnimationFrame(update);
			}
		};

		const requestUpdate = () => {
			if (ticking) return;
			ticking = true;
			frameId = requestAnimationFrame(update);
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					section.classList.add("is-inview");
					observer.unobserve(section);
				}
			},
			{ threshold: 0.15, rootMargin: "0px 0px -6% 0px" },
		);

		observer.observe(section);
		window.addEventListener("scroll", requestUpdate, { passive: true });
		window.addEventListener("resize", requestUpdate);
		requestUpdate();

		disposeContinueParallax = () => {
			observer.disconnect();
			window.removeEventListener("scroll", requestUpdate);
			window.removeEventListener("resize", requestUpdate);
			cancelAnimationFrame(frameId);
			ticking = false;
		};
	}

	initContinueParallax();
	document.addEventListener("astro:page-load", initContinueParallax);
</script>
