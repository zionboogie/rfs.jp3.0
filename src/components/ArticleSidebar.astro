---
import {
	type ArchiveGroup,
	type ArticleTag,
	type CategoryArticle,
	type SidebarLearnSection,
} from "../lib/wordpress";

interface Props {
	learnSections: SidebarLearnSection[];
	archiveGroups?: ArchiveGroup[];
	archiveTitle?: string;
	archiveHref?: string;
	tags: ArticleTag[];
	categoryName?: string;
	categoryArticles?: CategoryArticle[];
	currentArticleHref?: string;
}

const {
	learnSections,
	archiveGroups = [],
	archiveTitle = "過去アーカイブ",
	archiveHref = "/archive/",
	tags,
	categoryName = "",
	categoryArticles = [],
	currentArticleHref = "",
} = Astro.props;

function isCurrentArticle(href: string): boolean {
	const normalize = (value: string) => value.replace(/\/+$/, "");
	return normalize(href) === normalize(currentArticleHref);
}
---

<aside class="article-side flex flex-col gap-xl lg:sticky lg:top-md">
	{
		categoryName && categoryArticles.length > 0 ? (
			<section aria-labelledby="article-side-category-heading">
				<h2 class="article-side__heading" id="article-side-category-heading">
					{categoryName}
				</h2>
				<ol class="m-0 flex list-none flex-col gap-xs p-0">
					{categoryArticles.map((item, index) => {
						const isCurrent = isCurrentArticle(item.href);
						return (
							<li>
								<a
									class:list={[
										"flex items-start gap-xs py-xs no-underline",
										isCurrent ? "text-logo" : "text-muted",
									]}
									href={item.href}
									aria-current={isCurrent ? "page" : undefined}
								>
									<span
										class:list={[
											"grid size-8 shrink-0 place-items-center rounded-sm border text-sm font-bold leading-none tabular-nums",
											isCurrent
												? "border-logo bg-logo text-white"
												: "border-border bg-transparent text-text",
										]}
										aria-hidden="true"
									>
										{index + 1}
									</span>
									{item.title}
								</a>
							</li>
						);
					})}
				</ol>
			</section>
		) : null
	}
	{
		learnSections.map((section) => {
			const headingId = `article-side-learn-${section.slug}`;
			const courseHeadingId = `article-side-learn-courses-${section.slug}`;
			return (
				<section aria-labelledby={headingId}>
					<h2 class="article-side__heading" id={headingId}>
						<a class="text-inherit no-underline" href={section.href}>
							{section.title}
						</a>
					</h2>
					{
						section.courses.length > 0 ? (
							<div class="mt-md">
								<h3 class="mb-xs mt-0 text-sm font-bold tracking-[0.08em]" id={courseHeadingId}>
									講座リスト
								</h3>
								<ul class="m-0 flex list-none flex-col p-0" aria-labelledby={courseHeadingId}>
									{section.courses.map((course) => (
										<li class="border-b border-[rgb(33_5_5_/_18%)]">
											<a class="article-side__link block py-sm" href={course.href}>
												<span class="article-side__text">{course.title}</span>
											</a>
										</li>
									))}
								</ul>
							</div>
						) : null
					}
				</section>
			);
		})
	}

	{
		archiveGroups.length > 0 ? (
			<section aria-labelledby="article-side-archive-heading">
				<h2 class="article-side__heading" id="article-side-archive-heading">
					<a class="text-inherit no-underline" href={archiveHref}>
						{archiveTitle}
					</a>
				</h2>
				{archiveGroups.map((group, groupIndex) => (
					<div class:list={[groupIndex > 0 && "mt-md"]}>
						<h3 class="mb-xs mt-0 text-sm font-bold tracking-[0.08em]">{group.title}</h3>
						<ul class="m-0 flex list-none flex-col p-0">
							{group.children.map((child) => (
								<li class="border-b border-[rgb(33_5_5_/_18%)]">
									<a class="article-side__link block py-sm" href={child.href}>
										<span class="article-side__text">{child.title}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				))}
			</section>
		) : null
	}

	<section data-popular-articles hidden aria-labelledby="article-side-popular-heading">
		<h2 class="article-side__heading" id="article-side-popular-heading">
			人気記事
		</h2>
		<ul class="m-0 flex list-none flex-col p-0" data-popular-articles-list></ul>
	</section>

	{
		tags.length > 0 ? (
			<section aria-labelledby="article-side-tag-heading">
				<h2 class="article-side__heading" id="article-side-tag-heading">タグ</h2>
				<ul class="article-side__tags m-0 flex list-none flex-wrap gap-xs p-0">
					{tags.map((tag) => (
						<li>
							<a class="inline-block rounded-sm border border-border px-2 py-0.5 text-sm text-muted" href={tag.href}>
								{tag.label}
							</a>
						</li>
					))}
				</ul>
			</section>
		) : null
	}
</aside>

<script>
	const POPULAR_ARTICLES_URL = "/popular-articles.json";
	const POPULAR_ARTICLE_LIMIT = 5;

	function renderPopularArticles(articles) {
		const section = document.querySelector("[data-popular-articles]");
		const list = document.querySelector("[data-popular-articles-list]");
		if (!(section instanceof HTMLElement) || !(list instanceof HTMLElement)) return;

		list.replaceChildren();
		for (const article of articles.slice(0, POPULAR_ARTICLE_LIMIT)) {
			if (!article?.title || !article?.href) continue;
			const item = document.createElement("li");
			item.className = "border-b border-[rgb(33_5_5_/_18%)]";
			const link = document.createElement("a");
			link.className = "article-side__link block py-sm no-underline";
			link.href = article.href;
			const text = document.createElement("span");
			text.className = "article-side__text";
			text.textContent = article.title;
			link.append(text);
			item.append(link);
			list.append(item);
		}
		section.hidden = list.childElementCount === 0;
	}

	async function loadPopularArticles() {
		try {
			const response = await fetch(POPULAR_ARTICLES_URL, { cache: "no-store" });
			if (!response.ok) return;
			const data = await response.json();
			const articles = Array.isArray(data?.articles) ? data.articles : [];
			renderPopularArticles(articles);
		} catch {
			renderPopularArticles([]);
		}
	}

	loadPopularArticles();
</script>

