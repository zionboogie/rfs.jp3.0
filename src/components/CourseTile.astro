---
interface Props {
	title: string;
	description: string;
	href: string;
	iconLabel?: string;
	iconColor?: string;
	iconTextColor?: string;
}

const {
	title,
	description,
	href,
	iconColor = "var(--color-primary)",
	iconTextColor = "#fff",
} = Astro.props;
---

<a
	href={href}
	class="tile-card"
	style={`--tile-title-bg: ${iconColor}; --tile-title-color: ${iconTextColor}`}
>
	<h3 class="tile-card__title">{title}</h3>
	<p class="tile-card__description">{description}</p>
</a>
