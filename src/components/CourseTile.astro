---
interface Props {
	title: string;
	description?: string;
	href: string;
	index?: number;
	iconLabel?: string;
	iconColor?: string;
	iconTextColor?: string;
}

const {
	title,
	description,
	href,
	index = 0,
	iconColor = "var(--color-primary)",
	iconTextColor = "#fff",
} = Astro.props;
---

<a
	href={href}
	class="tile-card flex flex-col gap-sm rounded-lg border border-border bg-[#f7f5f2] p-md text-inherit no-underline"
	style={`--tile-index: ${index}; --tile-title-bg: ${iconColor}; --tile-title-color: ${iconTextColor}`}
>
	<h3
		class:list={[
			"tile-card__title m-0 max-w-full text-[clamp(1.25rem,2.2vw,1.625rem)] leading-[1.35]",
			description ? "w-fit rounded-sm px-[0.45em] py-[0.2em]" : "font-bold tracking-[0.02em]",
		]}
		style={description ? "background-color: var(--tile-title-bg); color: var(--tile-title-color)" : undefined}
	>
		{title}
	</h3>
	{
		description ? (
			<p class="tile-card__description text-[clamp(1.0625rem,1.6vw,1.25rem)] leading-[1.7] text-muted">{description}</p>
		) : null
	}
</a>
