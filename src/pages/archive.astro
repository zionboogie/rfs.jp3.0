---
import Layout from "../components/Layout.astro";
import CourseListItem from "../components/CourseListItem.astro";
import { findArchiveCategory, toSitePath, wpText } from "../lib/wordpress";
import "../styles/category.css";

const archiveRoots = ["sb", "server"] as const;
const items: { title: string; description: string; href: string }[] = [];

for (const slug of archiveRoots) {
	const category = await findArchiveCategory(slug);
	if (!category) continue;
	const path = toSitePath(category.link);
	items.push({
		title: wpText(category.name),
		description: wpText(category.description),
		href: path.endsWith("/") ? path : `${path}/`,
	});
}
---

<Layout title="アーカイブ" description="過去の記事アーカイブ" skipIntro>
	<main>
		<header class="category-hero">
			<div class="container">
				<h1 class="category-hero__title mb-md font-bold tracking-[0.04em] text-h1 leading-heading">アーカイブ</h1>
				<div class="course-list mt-xl border-t border-[rgb(33_5_5_/_18%)]">
					{items.map((item, index) => (
						<CourseListItem index={index + 1} title={item.title} description={item.description} href={item.href} />
					))}
				</div>
			</div>
		</header>
	</main>
</Layout>
