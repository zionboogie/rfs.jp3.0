---
import Layout from "../../components/Layout.astro";
import CourseListItem from "../../components/CourseListItem.astro";
import LearnCategoryPreview from "../../components/LearnCategoryPreview.astro";
import { hiddenArchiveTitles } from "../../data/courses";
import {
	findArchiveCategory,
	getChildSummaries,
	getLatestCategoryArticles,
	getLearnCategoryPreviews,
	toSitePath,
	wpText,
	type CoursePreview,
	type WpCategory,
} from "../../lib/wordpress";
import { collectionJsonLd } from "../../lib/structured-data";
import { categoryListTitle } from "../../lib/seo";

export async function getStaticPaths() {
	const sections = ["sb", "server", "learn"] as const;
	const paths: { params: { section: string }; props: { category: WpCategory } }[] = [];

	for (const section of sections) {
		const category = await findArchiveCategory(section);
		if (!category) continue;
		paths.push({
			params: { section },
			props: { category },
		});
	}

	return paths;
}

interface Props {
	category: WpCategory;
}

const { category } = Astro.props;
const isLearn = category.taxonomy === "learn_cat" || category.slug === "learn";
const [childSummaries, latestArticles, learnPreviews] = await Promise.all([
	isLearn ? Promise.resolve([]) : getChildSummaries(category),
	getLatestCategoryArticles(category),
	isLearn ? getLearnCategoryPreviews(category) : Promise.resolve([] as CoursePreview[]),
]);
const children = childSummaries.filter((child) => !hiddenArchiveTitles.has(child.title));
const title = wpText(category.name);
const description = wpText(category.description).trim();
const pageDescription = description || `${title}の一覧`;
const jsonLd = collectionJsonLd({
	origin: Astro.url.origin,
	name: title,
	description: pageDescription,
	url: toSitePath(category.link),
	items: latestArticles.map((article) => ({ name: article.title, url: article.href })),
});
---

<Layout title={categoryListTitle(title)} description={pageDescription} skipIntro jsonLd={jsonLd}>
	<main>
		<header class="category-hero pt-xl pb-xl">
			<div class="container">
				<h1 class="category-hero__title mb-xl font-bold tracking-[0.04em] text-h1 leading-heading">
					{title}
				</h1>
				{description ? <p class="category-hero__lead m-0 max-w-[40rem] text-muted leading-body">{description}</p> : null}
				<div class:list={["course-list mt-xl", !isLearn && "border-t border-[rgb(33_5_5_/_18%)]"]}>
					{
						isLearn
							? learnPreviews.map((course) => (
									<LearnCategoryPreview title={course.title} href={course.href} articles={course.articles} />
								))
							: children.map((child, index) => (
									<CourseListItem index={index + 1} title={child.title} description={child.description} href={child.href} />
								))
					}
				</div>
			</div>
		</header>
	</main>
</Layout>
