---
import Layout from "../components/Layout.astro";
import ArticlePage from "../components/ArticlePage.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { getLearnCourses } from "../lib/wordpress";

const learnCategories = await getLearnCourses();
---

<Layout title="変数の宣言と使い方" description="プログラムの中で値を覚えておく箱、それが変数です。まずは宣言のしかたと、名前の付け方から見ていきます。" skipIntro>
	<ArticlePage learnCategories={learnCategories} />
	<Breadcrumb placement="bottom" />
</Layout>
