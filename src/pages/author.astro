---
import Layout from "../components/Layout.astro";
import { getWpPageBySlug } from "../lib/wordpress";

const page = await getWpPageBySlug("author");
if (!page) {
	throw new Error("WordPress の固定ページ（スラッグ: author）が見つかりません。");
}
---

<link rel="stylesheet" href="/common/css/article-body.css" />
<Layout title={page.title} description={page.description || page.title} skipIntro>
	<main>
		<article>
			<header class="category-hero pt-xl pb-xl">
				<div class="container">
					<h1 class="category-hero__title mb-xl font-bold tracking-[0.04em] text-h1 leading-heading">
						{page.title}
					</h1>
				</div>
			</header>
			<div class="container pb-xl">
				<div class="article-body" set:html={page.body} />
			</div>
		</article>
	</main>
</Layout>
