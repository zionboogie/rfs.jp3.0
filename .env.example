# ----------------------------------------
# Astro / WordPress（ビルド・開発用）
# ----------------------------------------
# WordPress REST API のベース URL（末尾スラッシュなし）
# 例: https://example.com/wp/wp-json
# 例: https://example.com/wp/?rest_route=
WORDPRESS_API_URL=https://rfs.jp/wp/wp-json/

# ----------------------------------------
# 人気記事（scripts/fetch-popular-articles.mjs / 本番 cron）
# ----------------------------------------
# GA4 プロパティ ID（数字のみ、または properties/123456789）
GA4_PROPERTY_ID=351119610

# 集計対象ホスト（任意。指定するとそのホストだけ）
GA4_HOSTNAME=rfs.jp

# 出力先（任意。本番は公開ディレクトリの絶対パスを指定）
# 未指定時: リポジトリの public/popular-articles.json
POPULAR_ARTICLES_PATH=/var/www/v3.rfs.jp/current/popular-articles.json

# 認証は次のいずれか 1 つ

# A) サービスアカウント JSON を1行で（改行は \n にエスケープ）
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# B) メール + 秘密鍵（改行は \n）
# GA4_CLIENT_EMAIL=...@....iam.gserviceaccount.com
# GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# C) JSON ファイルのパス
GOOGLE_APPLICATION_CREDENTIALS=/home/ec2-user/banded-equator-146705-df3e0cb8e331.json
